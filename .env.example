# ==============================================================================
# Gmail AI Email Cleaner - Configuration Template
# Copy this file to .env and fill in your credentials.
# Never commit your actual .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GMAIL ACCOUNT SETTINGS
# ------------------------------------------------------------------------------
# Your full Gmail or Google Workspace address
GMAIL_USER=your_email@gmail.com

# 16-character Google App Password (NOT your regular Google account password).
# To generate one:
#   1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Go to App Passwords: https://myaccount.google.com/apppasswords
#   3. Create an app named "Email Cleaner" and copy the generated 16-character code.
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------------------------
# 2. GEMINI AI SETTINGS
# ------------------------------------------------------------------------------
# Google Gemini API Key from Google AI Studio:
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Gemini Model to use for scanning and validation:
# - gemini-2.5-flash (Recommended: fast, high quality, large context)
# - gemini-2.0-flash
# - gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. PERFORMANCE & PIPELINE SETTINGS (OPTIONAL)
# ------------------------------------------------------------------------------
# Number of emails evaluated per Gemini API prompt (default: 50)
BATCH_SIZE=50

# Maximum parallel worker threads for Gemini scanning and validation.
# - Paid Tier (Pay-As-You-Go): 10 to 20 workers (1,000 RPM quota)
# - Free Tier: Set to 1 or 2 workers (15 RPM quota)
MAX_WORKERS=10

# Maximum character length of email body snippet to analyze (default: 250)
SNIPPET_LENGTH=250
